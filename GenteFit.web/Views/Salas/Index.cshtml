@model List<GenteFit.Persistencia.Entidades.Sala>

@{
    ViewData["Title"] = "Salas";
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<h1>Salas</h1>

<a asp-controller="Salas" asp-action="Crear" class="btn btn-primary">
    Crear sala
</a>

@if (Model.Count == 0)
{
    <p>No hay salas registradas.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Ubicación</th>
                <th>Activa</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sala in Model)
            {
                <tr>
                    <td>@sala.Id</td>
                    <td>@sala.Nombre</td>
                    <td>@sala.Ubicacion</td>
                    <td>@(sala.Activa ? "Sí" : "No")</td>
                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@sala.Id"
                           class="btn btn-secondary btn-sm">
                            Editar
                        </a>

                        @if (sala.Activa)
                        {
                            <form asp-action="Desactivar"
                                  method="post"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@sala.Id" />

                                <button type="submit" class="btn btn-warning btn-sm">
                                    Desactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activar"
                                  method="post"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@sala.Id" />

                                <button type="submit" class="btn btn-success btn-sm">
                                    Activar
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}