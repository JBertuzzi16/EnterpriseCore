@model GenteFit.Persistencia.Entidades.Sala

@{
    ViewData["Title"] = "Editar sala";
}

<h1>Editar sala</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Salas" asp-action="Editar" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Ubicacion" class="form-label">Ubicación</label>
        <input asp-for="Ubicacion" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>