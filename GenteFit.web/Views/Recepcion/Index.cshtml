@using GenteFit.Persistencia.Entidades
@model List<Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes</h1>

<a asp-action="Alta" class="btn btn-primary">
    Nuevo cliente
</a>

@if (Model.Count == 0)
{
    <p class="mt-3">No hay clientes registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Apellidos</th>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th>Ficha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Apellidos</td>
                        <td>@cliente.Nombre</td>
                        <td>@(cliente.Activo ? "Activo" : "De baja")</td>
                        <td>
                            <a asp-action="Ficha"
                               asp-route-id="@cliente.Id"
                               class="btn btn-secondary btn-sm">
                                Ver ficha
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}