@model List<GenteFit.Persistencia.Entidades.Actividad>

@{
    ViewData["Title"] = "Actividades";
}

<h1>Actividades</h1>
<a asp-action="Crear" class="btn btn-primary">Crear actividad</a>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0)
{
    <p>No hay actividades registradas.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Intensidad</th>
                <th>Duración</th>
                <th>Activa</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var actividad in Model)
            {
                <tr>
                    <td>@actividad.Id</td>
                    <td>@actividad.Nombre</td>
                    <td>@actividad.Descripcion</td>
                    <td>@actividad.Intensidad</td>
                    <td>@actividad.DuracionMinutos min</td>
                    <td>@(actividad.Activa ? "Sí" : "No")</td>
                </tr>
                <td>
                    <a asp-action="Editar"
                       asp-route-id="@actividad.Id"
                       class="btn btn-secondary btn-sm">
                        Editar
                    </a>

                    @if (actividad.Activa)
                    {
                        <form asp-action="Desactivar" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@actividad.Id" />
                            <button type="submit" class="btn btn-warning btn-sm">
                                Desactivar
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activar" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@actividad.Id" />
                            <button type="submit" class="btn btn-success btn-sm">
                                Activar
                            </button>
                        </form>
                    }
                </td>
            }
        </tbody>
    </table>
}